<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VLE Daily Life Solution - Smart VLE Business System</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        csc: {
                            blue: '#1d4ed8',
                            darkblue: '#1e3a8a',
                            light: '#f8fafc',
                            accent: '#3b82f6'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col pb-24 md:pb-0">

    <!-- AUTHENTICATION / REGISTRATION SCREEN -->
    <div id="authScreen" class="fixed inset-0 bg-blue-900 z-50 flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-6 space-y-6 my-8">
            <div class="text-center">
                <div class="bg-csc-blue text-white w-14 h-14 rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-lg mb-3">
                    <i class="fa-solid fa-id-card"></i>
                </div>
                <h1 class="text-2xl font-bold text-slate-900">VLE Daily Life Solution</h1>
                <p class="text-xs text-slate-500 mt-1">Smart VLE Business Office Suite & Digital Services in Odisha</p>
            </div>

            <div class="flex bg-slate-100 p-1 rounded-xl">
                <button type="button" onclick="switchAuthTab('login')" id="authTabLoginBtn" class="flex-1 py-2 rounded-lg text-xs font-semibold bg-white text-csc-blue shadow transition">Login</button>
                <button type="button" onclick="switchAuthTab('register')" id="authTabRegBtn" class="flex-1 py-2 rounded-lg text-xs font-semibold text-slate-600 transition">New VLE Registration</button>
            </div>

            <div id="authErrorMsg" class="hidden bg-rose-50 border border-rose-200 text-rose-600 text-xs p-3 rounded-xl text-center"></div>

            <!-- LOGIN FORM -->
            <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Login Email / Mobile *</label>
                    <input type="text" id="loginEmail" required value="vle1@csc.gov.in" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-csc-blue focus:outline-none" placeholder="Enter email or mobile">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Password *</label>
                    <input type="password" id="loginPassword" required value="password123" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-csc-blue focus:outline-none" placeholder="Enter password">
                </div>
                <button type="submit" class="w-full bg-csc-blue hover:bg-blue-700 text-white font-semibold py-3 rounded-xl text-sm shadow transition">
                    Secure Login
                </button>
                <div class="border-t pt-3 text-center">
                    <p class="text-xs text-slate-400 mb-2">Demo Accounts:</p>
                    <div class="flex justify-center gap-2">
                        <button type="button" onclick="fillDemoVLE(1)" class="text-xs bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg font-medium text-slate-700">VLE 1 (Priyadarsan)</button>
                        <button type="button" onclick="fillDemoVLE(2)" class="text-xs bg-purple-100 hover:bg-purple-200 px-3 py-1.5 rounded-lg font-medium text-purple-700">Admin Panel</button>
                    </div>
                </div>
            </form>

            <!-- REGISTRATION FORM -->
            <form id="registerForm" onsubmit="handleRegister(event)" class="space-y-3 hidden">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Full Name *</label>
                        <input type="text" id="regName" required placeholder="Priyadarsan Ojha" class="w-full px-3 py-2 border rounded-xl text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Mobile Number *</label>
                        <input type="tel" id="regMobile" required pattern="[0-9]{10}" placeholder="10-digit mobile" class="w-full px-3 py-2 border rounded-xl text-sm">
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Email (Login ID) *</label>
                        <input type="email" id="regEmail" required placeholder="vle@csc.gov.in" class="w-full px-3 py-2 border rounded-xl text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">District *</label>
                        <input type="text" id="regDistrict" required placeholder="Dhenkanal" class="w-full px-3 py-2 border rounded-xl text-sm">
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">CSC Centre Name *</label>
                        <input type="text" id="regCscName" required placeholder="DIGITAL DARSAN CSC" class="w-full px-3 py-2 border rounded-xl text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Password *</label>
                        <input type="password" id="regPassword" required placeholder="Min 6 chars" class="w-full px-3 py-2 border rounded-xl text-sm">
                    </div>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 rounded-xl text-sm shadow transition mt-2">
                    Complete VLE Registration & Start
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN APP WRAPPER -->
    <div id="mainAppWrapper" class="hidden flex flex-col min-h-screen">
        <!-- Top Header -->
        <header class="bg-csc-blue text-white shadow-md sticky top-0 z-40">
            <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="bg-white text-csc-blue font-bold px-3 py-1.5 rounded-xl shadow flex items-center space-x-2">
                        <i class="fa-solid fa-id-card text-lg"></i>
                        <span class="tracking-wide text-sm md:text-base">VLE Daily Life Solution</span>
                    </div>
                    <div>
                        <h1 class="font-bold text-base md:text-lg leading-tight" id="headerCscName">DIGITAL DARSAN CSC</h1>
                        <p class="text-xs text-blue-100">VLE: <span id="headerVleName">Priyadarsan</span> | <span class="text-emerald-300 font-medium">● Smart System Active</span></p>
                    </div>
                </div>

                <div class="flex items-center space-x-2 md:space-x-3">
                    <!-- Notification Bell -->
                    <div class="relative">
                        <button onclick="toggleNotificationDropdown()" class="relative bg-blue-800 hover:bg-blue-900 px-3 py-2 rounded-xl text-sm transition">
                            <i class="fa-solid fa-bell"></i>
                            <span id="notifBadge" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full">3</span>
                        </button>
                        <div id="notifDropdown" class="hidden absolute right-0 mt-2 w-80 bg-white text-slate-800 rounded-2xl shadow-2xl border border-slate-200 z-50 p-3 space-y-2">
                            <div class="flex justify-between items-center border-b pb-2">
                                <span class="font-bold text-xs uppercase text-slate-500">Notifications & Follow-ups</span>
                                <span onclick="toggleNotificationDropdown()" class="cursor-pointer text-xs text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></span>
                            </div>
                            <div id="notifListContainer" class="space-y-2 max-h-64 overflow-y-auto text-xs"></div>
                        </div>
                    </div>

                    <div class="relative hidden md:block w-56 lg:w-72">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="globalSearchInput" oninput="handleGlobalSearch(this.value)" placeholder="Search customer, vehicle, app no..." class="w-full pl-9 pr-4 py-1.5 bg-blue-800 text-white placeholder-blue-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-white">
                    </div>
                    <button onclick="openModal('modalNewCustomer')" class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs md:text-sm font-semibold px-3 py-2 rounded-xl shadow transition flex items-center space-x-1">
                        <i class="fa-solid fa-user-plus"></i>
                        <span class="hidden sm:inline">Customer</span>
                    </button>
                    <button onclick="openModal('modalNewWork')" class="bg-amber-400 hover:bg-amber-500 text-slate-900 text-xs md:text-sm font-semibold px-3 py-2 rounded-xl shadow transition flex items-center space-x-1">
                        <i class="fa-solid fa-file-circle-plus"></i>
                        <span class="hidden sm:inline">Work</span>
                    </button>
                    <button onclick="handleLogout()" class="text-xs bg-blue-800 hover:bg-blue-900 px-3 py-2 rounded-xl font-medium transition" title="Logout">
                        <i class="fa-solid fa-power-off"></i>
                    </button>
                </div>
            </div>
        </header>

        <div class="max-w-7xl mx-auto w-full flex-1 flex flex-col md:flex-row px-2 md:px-4 py-4 gap-4">
            <!-- Desktop Sidebar Navigation -->
            <aside class="hidden md:block w-64 bg-white rounded-2xl shadow-sm border border-slate-200 p-4 shrink-0 h-fit sticky top-20">
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 px-3">Main Menu</div>
                <nav class="space-y-1">
                    <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-chart-pie w-5 text-center"></i><span>Dashboard</span>
                    </button>
                    <button onclick="switchTab('customers')" id="nav-customers" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-users w-5 text-center"></i><span>Smart Customers CRM</span>
                    </button>
                    <button onclick="switchTab('khata')" id="nav-khata" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-book-bookmark w-5 text-center text-emerald-600"></i><span>Digital Khata (Ledger)</span>
                    </button>
                    <button onclick="switchTab('vehicles')" id="nav-vehicles" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-car w-5 text-center"></i><span>Vehicle Renewals</span>
                    </button>
                    <button onclick="switchTab('work')" id="nav-work" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-file-lines w-5 text-center"></i><span>Work & Staff Tracker</span>
                    </button>
                    <button onclick="switchTab('pending')" id="nav-pending" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-clock-rotate-left w-5 text-center"></i><span>Pending & Follow-ups</span>
                    </button>
                    <button onclick="switchTab('payments')" id="nav-payments" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-indian-rupee-sign w-5 text-center"></i><span>Payments & Dues</span>
                    </button>
                    <button onclick="switchTab('business')" id="nav-business" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-wallet w-5 text-center"></i><span>My Business & Income</span>
                    </button>
                    <button onclick="switchTab('cashbook')" id="nav-cashbook" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-book-open w-5 text-center"></i><span>Daily Cashbook</span>
                    </button>
                    <button onclick="switchTab('offers')" id="nav-offers" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-bullhorn w-5 text-center text-amber-500"></i><span>Smart Offers & Poster</span>
                    </button>
                    <button onclick="switchTab('whatsapp')" id="nav-whatsapp" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-brands fa-whatsapp w-5 text-center text-emerald-500"></i><span>WhatsApp Center</span>
                    </button>
                    <button onclick="switchTab('documents')" id="nav-documents" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-folder-open w-5 text-center"></i><span>Document Vault</span>
                    </button>
                    <button onclick="switchTab('reports')" id="nav-reports" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-chart-column w-5 text-center"></i><span>Reports & Tax Export</span>
                    </button>
                    <button onclick="switchTab('admin')" id="nav-admin" class="nav-btn hidden w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-purple-700 hover:bg-purple-50 transition">
                        <i class="fa-solid fa-shield-halved w-5 text-center"></i><span>Admin Panel</span>
                    </button>
                    <button onclick="switchTab('settings')" id="nav-settings" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-blue-50 hover:text-csc-blue transition">
                        <i class="fa-solid fa-gear w-5 text-center"></i><span>Settings</span>
                    </button>
                </nav>
            </aside>

            <!-- Main Content Area -->
            <main class="flex-1 w-full overflow-hidden">
                <!-- Mobile Search Bar -->
                <div class="mb-3 md:hidden">
                    <div class="relative w-full">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="mobileSearchInput" oninput="handleGlobalSearch(this.value)" placeholder="Search customer, vehicle, app no..." class="w-full pl-9 pr-4 py-2 bg-white border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-csc-blue">
                    </div>
                </div>

                <!-- Global Search Results View -->
                <div id="globalSearchResults" class="hidden mb-4 bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="font-bold text-slate-800 text-base"><i class="fa-solid fa-search mr-2 text-csc-blue"></i>Global Search Results</h3>
                        <button onclick="closeGlobalSearch()" class="text-xs text-slate-500 hover:text-red-500"><i class="fa-solid fa-xmark text-lg"></i></button>
                    </div>
                    <div id="searchResultsContent" class="space-y-2 max-h-96 overflow-y-auto"></div>
                </div>

                <!-- TAB 1: DASHBOARD -->
                <section id="tab-dashboard" class="tab-content space-y-4">
                    <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white p-5 md:p-6 rounded-2xl shadow-md flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <h2 class="text-xl md:text-2xl font-bold" id="dashGreeting">Good Morning, Priyadarsan! 🙏</h2>
                            <p class="text-blue-100 text-sm mt-1">VLE Daily Life Solution: Enter data once, everything updates automatically ($100\%$ synced).</p>
                        </div>
                        <div class="flex gap-2 flex-wrap">
                            <button onclick="openModal('modalNewCustomer')" class="bg-white text-csc-blue px-4 py-2.5 rounded-xl text-xs md:text-sm font-semibold shadow hover:bg-blue-50 transition"><i class="fa-solid fa-user-plus mr-1"></i> New Customer</button>
                            <button onclick="openModal('modalNewWork')" class="bg-amber-400 text-slate-900 px-4 py-2.5 rounded-xl text-xs md:text-sm font-semibold shadow hover:bg-amber-300 transition"><i class="fa-solid fa-file-circle-plus mr-1"></i> New Work</button>
                        </div>
                    </div>

                    <!-- Digital Khata Quick Card Banner -->
                    <div onclick="switchTab('khata')" class="bg-gradient-to-r from-emerald-600 to-teal-700 text-white p-4 rounded-2xl shadow-sm cursor-pointer flex justify-between items-center hover:opacity-95 transition">
                        <div>
                            <span class="text-xs uppercase font-semibold text-emerald-200 tracking-wider">DIGITAL DARSAN CSC Khata (Ledger)</span>
                            <h3 id="dashKhataTotalDue" class="text-2xl font-bold mt-1">Total Customer Due: ₹0</h3>
                        </div>
                        <div class="bg-white/10 px-4 py-2 rounded-xl text-xs font-semibold flex items-center space-x-1">
                            <span>Open Ledger</span> <i class="fa-solid fa-chevron-right ml-1"></i>
                        </div>
                    </div>

                    <!-- Top Financial Quick Bar -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="bg-white p-3.5 rounded-2xl border border-slate-200">
                            <span class="text-[11px] font-semibold text-slate-500 uppercase">Today's Collection</span>
                            <h3 id="topDashToday" class="text-xl font-bold text-emerald-600 mt-1">₹0</h3>
                        </div>
                        <div class="bg-white p-3.5 rounded-2xl border border-slate-200">
                            <span class="text-[11px] font-semibold text-slate-500 uppercase">This Month Collection</span>
                            <h3 id="topDashMonth" class="text-xl font-bold text-csc-blue mt-1">₹0</h3>
                        </div>
                        <div class="bg-white p-3.5 rounded-2xl border border-slate-200">
                            <span class="text-[11px] font-semibold text-slate-500 uppercase">This Year Collection</span>
                            <h3 id="topDashYear" class="text-xl font-bold text-indigo-600 mt-1">₹0</h3>
                        </div>
                        <div class="bg-white p-3.5 rounded-2xl border border-slate-200">
                            <span class="text-[11px] font-semibold text-slate-500 uppercase">Net Business Income</span>
                            <h3 id="topDashNet" class="text-xl font-bold text-amber-600 mt-1">₹0</h3>
                        </div>
                    </div>

                    <!-- Dashboard Summary Cards -->
                    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-5 gap-3 md:gap-4">
                        <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-slate-500 uppercase">Customers</p>
                                <h3 id="statCustomers" class="text-2xl font-bold text-slate-800 mt-1">0</h3>
                                <span class="text-xs text-csc-blue font-medium">CRM Records</span>
                            </div>
                            <div class="bg-blue-50 text-csc-blue p-3.5 rounded-2xl text-xl"><i class="fa-solid fa-users"></i></div>
                        </div>
                        <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-slate-500 uppercase">Vehicles</p>
                                <h3 id="statVehicles" class="text-2xl font-bold text-amber-600 mt-1">0</h3>
                                <span class="text-xs text-amber-600 font-medium">Renewals due</span>
                            </div>
                            <div class="bg-amber-50 text-amber-600 p-3.5 rounded-2xl text-xl"><i class="fa-solid fa-car"></i></div>
                        </div>
                        <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-slate-500 uppercase">New Works</p>
                                <h3 id="statNewWorks" class="text-2xl font-bold text-indigo-600 mt-1">0</h3>
                                <span class="text-xs text-indigo-600 font-medium">Applications</span>
                            </div>
                            <div class="bg-indigo-50 text-indigo-600 p-3.5 rounded-2xl text-xl"><i class="fa-solid fa-file-lines"></i></div>
                        </div>
                        <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-slate-500 uppercase">Pending</p>
                                <h3 id="statPending" class="text-2xl font-bold text-amber-600 mt-1">0</h3>
                                <span class="text-xs text-amber-600 font-medium">Follow-ups</span>
                            </div>
                            <div class="bg-amber-50 text-amber-600 p-3.5 rounded-2xl text-xl"><i class="fa-solid fa-clock"></i></div>
                        </div>
                        <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-slate-500 uppercase">Birthdays</p>
                                <h3 id="statBirthdays" class="text-2xl font-bold text-purple-600 mt-1">0</h3>
                                <span class="text-xs text-purple-600 font-medium">Today</span>
                            </div>
                            <div class="bg-purple-50 text-purple-600 p-3.5 rounded-2xl text-xl"><i class="fa-solid fa-cake-candles"></i></div>
                        </div>
                    </div>

                    <!-- Quick Actions Grid -->
                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                        <h3 class="font-bold text-slate-800 text-sm mb-3">Quick Actions</h3>
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-2.5">
                            <button onclick="openModal('modalNewCustomer')" class="p-3 bg-blue-50 hover:bg-blue-100 text-csc-blue rounded-xl text-xs font-semibold flex flex-col items-center justify-center space-y-1.5 transition">

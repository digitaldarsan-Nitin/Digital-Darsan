        let activeData = null;

        // Persistent Storage
        const STORAGE_KEY = 'vle_daily_life_solution_store_v1';
        function loadPersistentStore() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return;
                const saved = JSON.parse(raw);
                if (saved && typeof saved === 'object') {
                    Object.keys(saved).forEach(email => {
                        if (saved[email] && typeof saved[email] === 'object') vleDataStore[email] = saved[email];
                    });
                }
            } catch (err) { console.warn('Store load failed', err); }
        }
        function persistStore() {
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(vleDataStore)); } catch (err) { console.warn('Store save failed', err); }
        }
        function persistActiveData() { if (activeData && currentUserEmail) { vleDataStore[currentUserEmail] = activeData; persistStore(); } }

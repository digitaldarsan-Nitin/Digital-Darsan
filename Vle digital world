                w.paid += Number(amt);
                activeData.cashbook.unshift({ id: Date.now(), vleId: activeData.vleId, type: "Income", category: w.service, desc: `${w.customerName} - Khata due collected`, mode: "Cash", amount: Number(amt), date: new Date().toISOString().split('T')[0] });

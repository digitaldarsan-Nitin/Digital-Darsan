            activeData.work.forEach(w => { counts[w.service] = (counts[w.service] || 0) + Number(w.total); });
            for (let [srv, amt] of Object.entries(counts)) {
                container.innerHTML += `<div class="flex justify-between items-center p-2.5 bg-slate-50 rounded-xl text-sm"><span class="font-medium">${srv}</span><span class="font-bold text-csc-blue">₹${amt}</span></div>`;
            }
            const col = activeData.work.reduce((a, b) => a + Number(b.paid), 0);
            const dues = activeData.work.reduce((a, b) => a + Math.max(0, Number(b.total) - Number(b.paid)), 0);
            const exp = activeData.expenses.reduce((a, b) => a + Number(b.amount), 0);
            document.getElementById('repTotalCol').innerText = '₹' + col;
            document.getElementById('repTotalDues').innerText = '₹' + dues;
            document.getElementById('repTotalExp').innerText = '₹' + exp;
            document.getElementById('repNetInc').innerText = '₹' + (col - exp);
        }

        function exportCSVData() {
            let csv = "Customer,Service,Status,Total,Paid,Date\n";
            activeData.work.forEach(w => { csv += `"${w.customerName}","${w.service}","${w.status}",${w.total},${w.paid},"${w.date}"\n`; });
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url; a.download = 'vle_tax_report.csv'; a.click();
        }

        function saveSettings() {
            activeData.settings.vleName = document.getElementById('setVleName').value;
            activeData.settings.cscName = document.getElementById('setCscName').value;
            activeData.settings.cscId = document.getElementById('setCscId').value;
            activeData.settings.mobile = document.getElementById('setMobile').value;
            applySettingsToUI(); persistActiveData(); showToast("Settings updated ✓");
        }

        function downloadBackup() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(activeData, null, 2));
            const a = document.createElement('a'); a.href = dataStr; a.download = `vle_backup_${activeData.vleId}.json`; a.click();
        }

        function renderAdminPanel() {
            document.getElementById('adminStatVles').innerText = Object.keys(vleDataStore).length - 1;
            const allCust = Object.keys(vleDataStore).reduce((acc, k) => k !== 'admin@csc.gov.in' ? acc + vleDataStore[k].customers.length : acc, 0);
            const allRev = Object.keys(vleDataStore).reduce((acc, k) => k !== 'admin@csc.gov.in' ? acc + vleDataStore[k].cashbook.filter(c => c.type==='Income').reduce((x, y) => x + Number(y.amount), 0) : acc, 0);

            document.getElementById('adminStatCust').innerText = allCust;
            document.getElementById('adminStatRev').innerText = '₹' + allRev;

            const tbody = document.getElementById('adminVlesTableBody');
            tbody.innerHTML = '';
            Object.keys(vleDataStore).forEach(email => {
                if (email === 'admin@csc.gov.in') return;
                const v = vleDataStore[email];
                tbody.innerHTML += `
                    <tr>
                        <td class="p-3 font-medium">${v.settings.vleName}<br><span class="text-xs text-slate-400">${email}</span></td>
                        <td class="p-3">${v.settings.cscName}</td>
                        <td class="p-3">${v.settings.district || 'N/A'}</td>
                        <td class="p-3 text-right"><span class="px-2.5 py-1 bg-emerald-100 text-emerald-700 font-bold text-xs rounded">Active VLE</span></td>
                    </tr>
                `;
            });
        }

        function showToast(msg) {
            const div = document.createElement('div');
            div.className = 'fixed top-16 right-4 bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-2xl z-50 text-xs md:text-sm font-medium transition animate-bounce';
            div.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400 mr-2"></i> ${msg}`;
            document.body.appendChild(div);
            setTimeout(() => div.remove(), 3000);
        }

        window.onload = function() {
            document.getElementById('exDate').valueAsDate = new Date();
            document.getElementById('cashbookDateFilter').value = new Date().toISOString().split('T')[0];
            document.getElementById('vhInsExpiry').value = new Date(Date.now() + 30*24*60*60*1000).toISOString().split('T')[0];
        };
    </script>
</body>
</html>

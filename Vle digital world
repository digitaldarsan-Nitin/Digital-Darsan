            document.getElementById('setCscId').value = activeData.settings.cscId || '';
            document.getElementById('setMobile').value = activeData.settings.mobile;
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('bg-blue-50', 'text-csc-blue'));
            const nav = document.getElementById('nav-' + tabId);
            if (nav) nav.classList.add('bg-blue-50', 'text-csc-blue');

            document.querySelectorAll('.mobile-nav-btn').forEach(el => el.classList.remove('text-csc-blue'));
            const mob = document.querySelector(`.mobile-nav-btn[data-tab="${tabId}"]`);
            if (mob) mob.classList.add('text-csc-blue');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }


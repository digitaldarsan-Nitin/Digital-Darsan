        setInterval(persistStore, 1500);
        loadPersistentStore();

        function switchAuthTab(tab) {
            const loginBtn = document.getElementById('authTabLoginBtn');
            const regBtn = document.getElementById('authTabRegBtn');
            const loginForm = document.getElementById('loginForm');
            const regForm = document.getElementById('registerForm');

            if (tab === 'login') {
                loginBtn.className = "flex-1 py-2 rounded-lg text-xs font-semibold bg-white text-csc-blue shadow transition";
                regBtn.className = "flex-1 py-2 rounded-lg text-xs font-semibold text-slate-600 transition";
                loginForm.classList.remove('hidden'); regForm.classList.add('hidden');
            } else {
                regBtn.className = "flex-1 py-2 rounded-lg text-xs font-semibold bg-white text-csc-blue shadow transition";
                loginBtn.className = "flex-1 py-2 rounded-lg text-xs font-semibold text-slate-600 transition";
                regForm.classList.remove('hidden'); loginForm.classList.add('hidden');
            }
        }

